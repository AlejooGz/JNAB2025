<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/cream">

    <ImageButton
        android:id="@+id/btnCerrar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/baseline_close_24"
        android:contentDescription="Cerrar"
        android:background="?selectableItemBackgroundBorderless"
        app:tint="@color/dark_red"
        android:layout_gravity="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filtrar por:"
        android:textColor="@color/dark_red"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:singleSelection="false"
        app:selectionRequired="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHospedaje"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hospedajes"
            android:textAllCaps="false"
            android:textColor="@color/filtro_boton_texto"
            app:backgroundTint="@color/filtro_boton_fondo"
            app:strokeColor="@color/dark_red"
            app:strokeWidth="1dp"
            app:cornerRadius="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestaurante"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurantes"
            android:textAllCaps="false"
            android:textColor="@color/filtro_boton_texto"
            app:backgroundTint="@color/filtro_boton_fondo"
            app:strokeColor="@color/dark_red"
            app:strokeWidth="1dp"
            app:cornerRadius="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgencia"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agencias"
            android:textAllCaps="false"
            android:textColor="@color/filtro_boton_texto"
            app:backgroundTint="@color/filtro_boton_fondo"
            app:strokeColor="@color/dark_red"
            app:strokeWidth="1dp"
            app:cornerRadius="20dp"/>

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuitarFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Quitar filtros"
        android:textAllCaps="false"
        android:textColor="@color/dark_red"
        app:backgroundTint="@color/light_pink"
        app:strokeColor="@color/dark_red"
        app:strokeWidth="1dp"
        app:cornerRadius="20dp" />

</LinearLayout>