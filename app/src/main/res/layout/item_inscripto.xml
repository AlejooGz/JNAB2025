<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/cream"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/dark_red"/>

    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="correo@email.com"
        android:textSize="14sp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvRol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Expositor · Estudiante"
        android:textStyle="bold"
        android:textColor="@color/dark_red"/>

    <TextView
        android:id="@+id/tvEstadoPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Inscripción pendiente de pago"
        android:textColor="@color/black"/>

    <TextView
        android:id="@+id/tvComprobante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Comprobante pendiente"
        android:textColor="@color/black"/>

    <Button
        android:id="@+id/btnVerComprobante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/dark_red"
        android:textColor="@color/white"
        android:text="Ver comprobante" />

    <LinearLayout
        android:id="@+id/contenedorAcciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVerificar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/dark_red"
            android:textColor="@color/white"
            android:text="Verificar" />

        <Button
            android:id="@+id/btnRechazar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/dark_red"
            android:textColor="@color/white"
            android:text="Rechazar" />

    </LinearLayout>

</LinearLayout>