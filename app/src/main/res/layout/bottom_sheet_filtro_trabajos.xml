<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filtrar trabajos"
                android:textColor="@color/dark_red"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnCerrar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar"
                android:src="@drawable/baseline_close_24"
                app:tint="@color/dark_red"/>

        </LinearLayout>


        <!-- ESTADO DEL TRABAJO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Estado del trabajo"
            android:textColor="@color/dark_red"
            android:textSize="16sp"
            android:textStyle="bold"/>


        <!-- ENVIADO / EN EVALUACIÓN -->

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoEstados1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false"
            app:selectionRequired="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enviado"
                android:textAllCaps="false"
                android:textColor="@color/filtro_boton_texto"
                app:backgroundTint="@color/filtro_boton_fondo"
                app:strokeColor="@color/dark_red"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnEvaluacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="En evaluación"
                android:textAllCaps="false"
                android:textColor="@color/filtro_boton_texto"
                app:backgroundTint="@color/filtro_boton_fondo"
                app:strokeColor="@color/dark_red"
                app:strokeWidth="1dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>


        <!-- PENDIENTE DE PAGO / APROBADO / RECHAZADO -->

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoEstados2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false"
            app:selectionRequired="false">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAprobado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aprobado"
                android:textAllCaps="false"
                android:textColor="@color/filtro_boton_texto"
                app:backgroundTint="@color/filtro_boton_fondo"
                app:strokeColor="@color/dark_red"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rechazado"
                android:textAllCaps="false"
                android:textColor="@color/filtro_boton_texto"
                app:backgroundTint="@color/filtro_boton_fondo"
                app:strokeColor="@color/dark_red"
                app:strokeWidth="1dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>


        <!-- PROGRAMACIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Programación"
            android:textColor="@color/dark_red"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoProgramacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false"
            app:selectionRequired="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProgramado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Programado"
                android:textAllCaps="false"
                android:textColor="@color/filtro_boton_texto"
                app:backgroundTint="@color/filtro_boton_fondo"
                app:strokeColor="@color/dark_red"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSinProgramar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sin programar"
                android:textAllCaps="false"
                android:textColor="@color/filtro_boton_texto"
                app:backgroundTint="@color/filtro_boton_fondo"
                app:strokeColor="@color/dark_red"
                app:strokeWidth="1dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>


        <!-- QUITAR FILTROS -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuitarFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quitar filtros"
            android:textAllCaps="false"
            android:textColor="@color/dark_red"
            app:backgroundTint="@color/cream"
            app:strokeColor="@color/dark_red"
            app:strokeWidth="1dp"/>

    </LinearLayout>

</ScrollView>