<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ENCABEZADO -->
        <TextView
            android:id="@+id/tvEncabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dark_red"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/cream">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Título"
                    android:textColor="@color/dark_red"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Título de la actividad"
                    android:textColor="@color/dark_red"
                    android:textColorHint="@color/dusty_rose"
                    android:inputType="textCapSentences"
                    android:backgroundTint="@color/dark_red" />

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Descripción"
                    android:textColor="@color/dark_red"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Descripción de la actividad"
                    android:minLines="3"
                    android:textColor="@color/dark_red"
                    android:textColorHint="@color/dusty_rose"
                    android:inputType="textCapSentences|textMultiLine"
                    android:backgroundTint="@color/dark_red" />

                <!-- TIPO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tipo de actividad"
                    android:textColor="@color/dark_red"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_spinner_cream" />

                <!-- FECHA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Fecha de la Actividad"
                    android:textColor="@color/dark_red"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Elegir fecha"
                    android:textAllCaps="false"
                    android:textColor="@color/cream"
                    android:backgroundTint="@color/dark_red" />

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Elegir fecha"
                    android:textColor="@color/dark_red"
                    android:textSize="16sp" />

                <!-- AULA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Aula de la Actividad"
                    android:textColor="@color/dark_red"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Elegir aula"
                    android:textAllCaps="false"
                    android:textColor="@color/cream"
                    android:backgroundTint="@color/dark_red" />

                <TextView
                    android:id="@+id/tvAula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Elegir aula"
                    android:textColor="@color/dark_red"
                    android:textSize="16sp" />

                <!-- DURACIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Duración"
                    android:textColor="@color/dark_red"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spDuracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_spinner_cream" />

                <!-- HORARIO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Horario de inicio"
                    android:textColor="@color/dark_red"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Elegí uno de los bloques oficiales."
                    android:textColor="@color/dusty_rose"
                    android:textSize="13sp" />

                <!-- SLOTS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSlots"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvSinSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No hay horarios disponibles para esa duración."
                    android:textColor="@color/dark_red"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHorarioSeleccionado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Elegí un horario de inicio"
                    android:textColor="@color/dark_red"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- GUARDAR -->
                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Guardar actividad"
                    android:textAllCaps="false"
                    android:textColor="@color/cream"
                    android:backgroundTint="@color/dark_red" />

                <!-- CANCELAR -->
                <Button
                    android:id="@+id/btnCancelar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/dark_red"
                    android:backgroundTint="@android:color/transparent" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>