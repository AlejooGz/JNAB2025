<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de Novedad"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_red"
            android:paddingBottom="4dp"/>

        <ImageView
            android:id="@+id/ivImagenNovedad"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción breve de la novedad"
            android:textSize="14sp"
            android:textColor="@color/dusty_rose"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textSize="12sp"
            android:textColor="@color/dusty_rose"
            android:textStyle="italic"/>

        <!-- Acciones exclusivas del organizador -->
        <LinearLayout
            android:id="@+id/layoutAccionesNovedad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnEditarNovedad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textAllCaps="false"
                android:textColor="@color/cream"
                android:backgroundTint="@color/dark_red"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnEliminarNovedad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar"
                android:textAllCaps="false"
                android:textColor="@color/cream"
                android:backgroundTint="@color/dark_red"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>