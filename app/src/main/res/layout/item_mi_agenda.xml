<?xml version="1.0" encoding="utf-8"?>
<!-- Una actividad del itinerario, en tres columnas: la hora, la linea de tiempo
     con su punto, y la tarjeta.
     La hora va afuera de la tarjeta a proposito. Ademas de leerse como una
     agenda de papel, deja que el punto se alinee con ella: ConstraintLayout
     solo admite restricciones entre hermanos, y adentro de la CardView la hora
     no lo seria. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvHora"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="14dp"
        android:textAlignment="center"
        android:textColor="@color/dark_red"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="14:00" />

    <TextView
        android:id="@+id/tvHoraFin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/dusty_rose"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/tvHora"
        app:layout_constraintStart_toStartOf="@id/tvHora"
        app:layout_constraintTop_toBottomOf="@id/tvHora"
        tools:text="a 14:30" />

    <!-- Tramo de linea que sube hasta el punto. -->
    <View
        android:id="@+id/lineaArriba"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/dusty_rose"
        app:layout_constraintBottom_toTopOf="@id/punto"
        app:layout_constraintEnd_toEndOf="@id/punto"
        app:layout_constraintStart_toStartOf="@id/punto"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/punto"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/punto_agenda"
        app:layout_constraintBottom_toBottomOf="@id/tvHora"
        app:layout_constraintStart_toEndOf="@id/tvHora"
        app:layout_constraintTop_toTopOf="@id/tvHora" />

    <!-- Tramo de linea que baja desde el punto. -->
    <View
        android:id="@+id/lineaAbajo"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/dusty_rose"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/punto"
        app:layout_constraintStart_toStartOf="@id/punto"
        app:layout_constraintTop_toBottomOf="@id/punto" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/punto"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- La estrella y la etiqueta van en el mismo lugar y se excluyen:
                 si el usuario eligio la actividad se muestra la estrella, la
                 misma del cronograma, y sirve para sacarla. Si no, la etiqueta
                 dice que tipo de actividad es. -->
            <ImageView
                android:id="@+id/ivEstrella"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quitar de mi agenda"
                android:padding="9dp"
                android:src="@android:drawable/btn_star_big_on"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/light_pink"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/dark_red"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="COFFEE BREAK" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvEtiqueta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Variabilidad craneofacial en poblaciones del NOA" />

            <TextView
                android:id="@+id/tvLugar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/dark_red"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitulo"
                tools:text="Sala 1 · planta baja" />

            <TextView
                android:id="@+id/tvDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/dusty_rose"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLugar"
                tools:text="Expositor: Alejo González" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
