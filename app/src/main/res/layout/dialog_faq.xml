<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_cream">

    <TextView
        android:id="@+id/tvTituloFaqDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editar pregunta"
        android:textColor="@color/dark_red"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity=""
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etPreguntaDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pregunta"
        android:textColor="@color/dark_red"
        android:textColorHint="@color/dusty_rose"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="4"
        android:scrollHorizontally="false"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etRespuestaDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Respuesta"
        android:textColor="@color/dark_red"
        android:textColorHint="@color/dusty_rose"
        android:gravity="top"
        android:minLines="4"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etOrdenDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Orden"
        android:textColor="@color/dark_red"
        android:textColorHint="@color/dusty_rose"
        android:inputType="number"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Para quién es esta pregunta?"
        android:textColor="@color/dark_red"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgPublicoFaq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbAsistente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Asistente"
            android:textColor="@color/dark_red"/>

        <RadioButton
            android:id="@+id/rbExpositor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expositor"
            android:textColor="@color/dark_red"/>

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelarFaq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/dark_red"
            android:backgroundTint="@color/cream"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnGuardarFaq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:backgroundTint="@color/dark_red"/>

    </LinearLayout>

</LinearLayout>